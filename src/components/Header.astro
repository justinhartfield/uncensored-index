---
const links = [
  ['/climax-benchmark/', 'CLIMAX'],
  ['/suite/', 'Test suite'],
  ['/compare/', 'Compare'],
  ['/results/', 'Run ledger'],
  ['/models/', 'Models'],
  ['/methodology/', 'Method'],
  ['/review/', 'Review'],
  ['/archive/', 'Archive'],
] as const;
const current = Astro.url.pathname;
const active = (href: string) => href === '/' ? current === '/' : current.startsWith(href);
---
<header class="site-header">
  <div class="shell nav">
    <a class="brand" href="/" aria-label="Uncensored Index home">
      <span class="brand-mark" aria-hidden="true">03</span>
      <span class="brand-copy"><strong>Uncensored Index</strong><small>Independent model laboratory</small></span>
    </a>
    <nav class="nav-links nav-links--desktop" aria-label="Primary navigation">
      {links.map(([href, label]) => <a href={href} aria-current={active(href) ? 'page' : undefined}>{label}</a>)}
    </nav>
    <a class="run-pill" href="/results/"><span class="state-dot state-dot--live"></span><span>Live run<br /><strong>reviewed · published</strong></span></a>
    <details class="mobile-nav">
      <summary>Menu</summary>
      <nav aria-label="Mobile navigation">{links.map(([href, label]) => <a href={href} aria-current={active(href) ? 'page' : undefined}>{label}</a>)}</nav>
    </details>
  </div>
</header>
