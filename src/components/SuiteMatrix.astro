---
import { modalityMeta, v03CasesByModality, v03Modalities } from '../data/v03-suite';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<div class:list={['suite-matrix', { 'suite-matrix--compact': compact }]}>
  {v03Modalities.map((modality) => {
    const tests = v03CasesByModality.get(modality) || [];
    const meta = modalityMeta[modality];
    return (
      <section class="matrix-track" data-modality={modality} aria-labelledby={`matrix-${modality}`}>
        <header>
          <span class="track-code" aria-hidden="true">{meta.code}</span>
          <div><h3 id={`matrix-${modality}`}>{meta.label}</h3><p>{tests.length} cases · {meta.routeCount} live route{meta.routeCount === 1 ? '' : 's'}</p></div>
        </header>
        <div class="matrix-cells">
          {tests.map((test) => (
            <a
              href={`/suite/${test.slug}/`}
              class:list={['matrix-cell', { 'matrix-cell--boundary': test.family === 'boundary-control', 'matrix-cell--adult': test.adultFlagged }]}
              aria-label={`${test.id}: ${test.title}`}
            >
              <span class="matrix-cell__id">{test.id}</span>
              {!compact && <span class="matrix-cell__title">{test.title}</span>}
              <span class="matrix-cell__state">{test.technicalFailures ? '1 error' : `${test.executionCount} reviewed`}</span>
            </a>
          ))}
        </div>
      </section>
    );
  })}
</div>
<div class="matrix-legend" aria-label="Suite matrix legend">
  <span><i class="legend-mark"></i>Lawful capability</span>
  <span><i class="legend-mark legend-mark--boundary"></i>Audit-only boundary</span>
  <span><i class="legend-mark legend-mark--adult"></i>Adult-flagged definition</span>
  <span>All evidence: review complete</span>
</div>
