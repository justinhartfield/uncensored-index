---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClimaxModalityTable from './ClimaxModalityTable.astro';
import SuiteMatrix from './SuiteMatrix.astro';
import { mediaModels, models } from '../data/models';
import { modalityMeta, v03CasesByModality, v03Run, type V03SuiteCase } from '../data/v03-suite';
import { v03PublishedResultsByModality } from '../data/v03-public-results';
import { getClimaxRankings } from '../lib/climax-scores';
interface Props { modality: 'text' | 'image' | 'video' | 'audio'; }
const { modality } = Astro.props;
const meta = modalityMeta[modality];
const tests = (v03CasesByModality.get(modality) || []) as V03SuiteCase[];
const roster = [...models, ...mediaModels].filter((model) => model.modalities.includes(modality));
const publishedResults = v03PublishedResultsByModality.get(modality) || [];
const rankings = getClimaxRankings(modality);
const leader = rankings[0];
const seo = {
  text: {
    title: 'Uncensored AI text model rankings',
    description: 'Compare 13 uncensored AI text models using reviewed CLIMAX scores for instruction following, output quality, speed, and cost.',
  },
  image: {
    title: 'Uncensored AI image model rankings',
    description: 'Compare 3 uncensored AI image models using reviewed CLIMAX scores, delivery outcomes, latency, cost, and public evidence.',
  },
  video: {
    title: 'Uncensored AI video model results',
    description: 'See reviewed CLIMAX capability, quality, latency, cost, and evidence for the uncensored AI video model tested in v0.3.',
  },
  audio: {
    title: 'Uncensored AI audio model results',
    description: 'See reviewed CLIMAX capability, quality, latency, cost, and evidence for the uncensored AI audio model tested in v0.3.',
  },
} as const;
const pageCopy = seo[modality];
---
<BaseLayout title={pageCopy.title} description={pageCopy.description}>
  <header class="page-head page-head--dark">
    <div class="shell page-head__grid">
      <div><p class="kicker">CLIMAX 0.3 / {meta.code} track</p><h1>{pageCopy.title}</h1><p class="lede">{meta.description} Scores compare models only within this modality.</p></div>
      <dl class="page-stats"><div><dt>Cases</dt><dd>{tests.length}</dd></div><div><dt>Models scored</dt><dd>{rankings.length}</dd></div><div><dt>Executions</dt><dd>{tests.length * meta.routeCount}</dd></div></dl>
    </div>
  </header>
  <section class="section shell">
    <div class="section-head"><div><p class="kicker">{meta.label} rankings</p><h2>{rankings.length > 1 ? `${rankings.length} models compared` : 'Single-model capability profile'}</h2></div><a href="/methodology/">How scores work</a></div>
    <ClimaxModalityTable modality={modality} rankings={rankings} />
    {leader && <div class="callout"><p><strong>{leader.displayName} {rankings.length > 1 ? `ranks first among ${rankings.length} ${meta.label.toLowerCase()} models` : 'is the only model in this track'}</strong> with a CLIMAX score of {leader.score.toFixed(1)}. It fully delivered {leader.result.lawful.full} of {leader.result.lawful.total} lawful capability tests.</p></div>}
  </section>
  <section class="section section--tint"><div class="shell">
    <div class="review-banner"><span class="state-dot state-dot--live"></span><div><strong>Live run reviewed. Evidence published.</strong><p>{tests.length * meta.routeCount} {meta.label.toLowerCase()} executions retained in run <code>{v03Run.runId}</code>. {publishedResults.length} model routes have published outcomes.</p></div></div>
    <div class="section-head"><div><p class="kicker">Route coverage</p><h2>{roster.length} model{roster.length === 1 ? '' : 's'} tested</h2></div><a href="/results/">Open run ledger</a></div>
    <div class="ledger-list">{roster.map((model) => <a class="ledger-row" href={`/models/${model.slug}/`}><span>{model.displayName}</span><span>{model.providerId}</span><span>{model.slug === 'qwen3-6-35b-uncensored-e2ee' ? 'excluded / transport' : 'live / published'}</span></a>)}</div>
  </div></section>
  <section class="section shell"><div class="section-head"><div><p class="kicker">Test coverage</p><h2>{tests.length} frozen {meta.label.toLowerCase()} cases</h2></div><a href="/suite/">Full test suite</a></div><SuiteMatrix compact={true} /></section>
  <section class="section shell archive-note"><p><strong>Looking for the old scores?</strong> The v0.2 leaderboard is preserved in the <a href={`/archive/v02/${modality}/`}>versioned archive</a>. It is not comparable to this suite.</p></section>
</BaseLayout>
