---
import { getCombinedRankings } from '../lib/climax-scores';
const rankings = getCombinedRankings();

function scoreCell(value: number | null): string {
  return value !== null ? value.toFixed(1) : '\u2014';
}

function rankBadge(rank: number): string {
  if (rank === 1) return 'var(--amber)';
  if (rank === 2) return 'var(--muted)';
  if (rank === 3) return 'var(--warning)';
  return 'var(--line)';
}
---

<div class="table-wrap">
  <table class="climax-leaderboard">
    <caption class="sr-only">Combined CLIMAX Benchmark rankings across all modalities</caption>
    <thead>
      <tr>
        <th>Rank</th>
        <th>Model</th>
        <th>Combined</th>
        <th>Text</th>
        <th>Image</th>
        <th>Video</th>
        <th>Audio</th>
        <th>Latency</th>
        <th>Total Cost</th>
      </tr>
    </thead>
    <tbody>
      {rankings.map((entry) => (
        <tr class={entry.rank <= 3 ? 'climax-top3' : ''}>
          <td class="climax-rank">
            <span class="climax-rank-badge" style={`--rank-color: ${rankBadge(entry.rank)}`}>
              {entry.rank}
            </span>
          </td>
          <td><a href={`/models/${entry.modelSlug}/`}><strong>{entry.displayName}</strong></a></td>
          <td class="climax-combined">{entry.combinedScore.toFixed(1)}</td>
          <td class="mono">{scoreCell(entry.textScore)}</td>
          <td class="mono">{scoreCell(entry.imageScore)}</td>
          <td class="mono">{scoreCell(entry.videoScore)}</td>
          <td class="mono">{scoreCell(entry.audioScore)}</td>
          <td class="mono">{(entry.avgLatency / 1000).toFixed(1)}s</td>
          <td class="mono">${entry.totalCost.toFixed(2)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .climax-leaderboard th { font-family: var(--mono); font-size: 0.65rem; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.7rem 0.8rem; }
  .climax-leaderboard td { padding: 0.7rem 0.8rem; vertical-align: middle; }
  .climax-leaderboard td a { text-decoration: none; }
  .climax-leaderboard td a:hover { text-decoration: underline; }
  .climax-rank { width: 50px; text-align: center; }
  .climax-rank-badge { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; border: 2px solid var(--rank-color); font-family: var(--display); font-size: 0.85rem; font-weight: 850; }
  .climax-top3 { background: var(--paper-2); }
  .climax-combined { font-family: var(--display); font-size: 1.3rem; font-weight: 850; color: var(--cobalt); }
</style>
