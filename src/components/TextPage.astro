---
import BaseLayout from '../layouts/BaseLayout.astro';
interface Props { title: string; description: string; kicker?: string; noindex?: boolean; }
const { title, description, kicker = 'Uncensored Index', noindex = false } = Astro.props;
---
<BaseLayout title={title} description={description} noindex={noindex} type="article">
  <header class="page-head">
    <div class="shell reading">
      <p class="kicker">{kicker}</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
    </div>
  </header>
  <article class="section shell reading prose"><slot /></article>
</BaseLayout>
