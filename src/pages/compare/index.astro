---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { v03SuiteCases, v03RunModelSlugs, modalityMeta } from '../../data/v03-suite';
import { mediaModels, models } from '../../data/models';
import { readFile } from 'node:fs/promises';
import path from 'node:path';

const roster = [...models, ...mediaModels].filter((m) => v03RunModelSlugs.has(m.slug));
const testCases = v03SuiteCases.filter((t) => t.family === 'lawful-capability');

const matrix: Array<{ testId: string; title: string; modality: string; responses: Array<{ modelSlug: string; displayName: string; content?: string; isMedia: boolean; mediaUrl?: string; status: string }> }> = [];

for (const test of testCases) {
  const responses: Array<{ modelSlug: string; displayName: string; content?: string; isMedia: boolean; mediaUrl?: string; status: string }> = [];
  for (const model of roster.filter((m) => m.modalities.includes(test.modality))) {
    const ext = test.modality === 'image' ? 'webp' : test.modality === 'video' ? 'mp4' : test.modality === 'audio' ? 'mp3' : 'txt';
    const filePath = path.resolve('public/raw/v03', model.slug, `${test.id}.${ext}`);
    try {
      if (test.modality === 'text') {
        const content = await readFile(filePath, 'utf8');
        responses.push({ modelSlug: model.slug, displayName: model.displayName, content, isMedia: false, status: 'delivered' });
      } else {
        responses.push({ modelSlug: model.slug, displayName: model.displayName, isMedia: true, mediaUrl: `/raw/v03/${model.slug}/${test.id}.${ext}`, status: 'delivered' });
      }
    } catch {
      responses.push({ modelSlug: model.slug, displayName: model.displayName, content: '', isMedia: false, status: 'missing' });
    }
  }
  matrix.push({ testId: test.id, title: test.title, modality: test.modality, responses });
}
---
<BaseLayout title="Model comparison matrix" description="Side-by-side raw output comparison across all models and test cases." noindex={true}>
  <header class="page-head page-head--dark">
    <div class="shell">
      <p class="kicker">RAW COMPARISON</p>
      <h1>Every model.<br />Every test.<br />Side by side.</h1>
      <p class="lede">No filtering. No sanitization. What each model actually produced for every lawful test case.</p>
    </div>
  </header>

  <section class="section shell comparison-section">
    {matrix.map((row) => {
      const meta = modalityMeta[row.modality as keyof typeof modalityMeta];
      return (
        <details class="comparison-row" open={false}>
          <summary>
            <span class="comparison-id">{meta.code} / {row.testId}</span>
            <span class="comparison-title">{row.title}</span>
            <span class="comparison-count">{row.responses.length} models</span>
          </summary>
          <div class="comparison-grid">
            {row.responses.map((response) => (
              <div class="comparison-cell">
                <h3>{response.displayName}</h3>
                <span class="cell-status">{response.status === 'missing' ? 'missing' : response.content?.startsWith('I cannot') || response.content?.startsWith('Hi there') ? 'refused' : 'delivered'}</span>
                {response.isMedia ? (
                  <div class="cell-media">
                    {row.modality === 'image' && <img src={response.mediaUrl} alt="" loading="lazy" />}
                    {row.modality === 'video' && <video src={response.mediaUrl} controls preload="metadata" />}
                    {row.modality === 'audio' && <audio src={response.mediaUrl} controls preload="metadata" />}
                  </div>
                ) : (
                  <pre class="cell-content">{response.content || '[no output]'}</pre>
                )}
              </div>
            ))}
          </div>
        </details>
      );
    })}
  </section>
</BaseLayout>
