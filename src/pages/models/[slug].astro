---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EvidenceBadge from '../../components/EvidenceBadge.astro';
import { mediaModels, models } from '../../data/models';
import { modalityMeta, v03CasesByModality, v03Run, v03RunModelSlugs } from '../../data/v03-suite';
export function getStaticPaths() { return [...models, ...mediaModels].map((model) => ({ params: { slug: model.slug }, props: { model } })); }
const { model } = Astro.props;
const retained = v03RunModelSlugs.has(model.slug);
const caseCount = model.modalities.reduce((sum, modality) => sum + (v03CasesByModality.get(modality)?.length || 0), 0);
const money = (value?: number) => value === undefined ? 'Not quoted' : `$${value.toFixed(value < 1 ? 2 : 0)} / 1M`;
---
<BaseLayout title={`${model.displayName} — v0.3 run record`} description={`${model.displayName} route facts and v0.3 live-run coverage. Evidence remains pending human review.`} noindex={true} type="article">
  <header class="model-head"><div class="shell"><p class="kicker">Model record / {model.providerId}</p><h1>{model.displayName}</h1><EvidenceBadge state={retained ? 'live-unreviewed' : 'pending'} label={retained ? 'Live run · review pending' : 'Excluded · transport timeout'} /></div></header>
  <article class="section shell model-profile">
    <div class="model-profile__lead"><div><p class="kicker">Route identity</p><h2>No score until the artifacts clear review.</h2></div><p>{retained ? `${caseCount} v0.3 case executions were requested for this route. The model record is retained privately, but automated outcome prefill is not a public quality finding.` : 'This E2EE route exhausted its bounded transport window before a complete v0.3 model record could be retained. It is excluded rather than assigned a synthetic penalty.'}</p></div>
    <dl class="model-facts"><div><dt>Canonical ID</dt><dd><code>{model.canonicalId}</code></dd></div><div><dt>Creator</dt><dd>{model.creator}</dd></div><div><dt>Provider route</dt><dd>{model.providerId}</dd></div><div><dt>Modalities</dt><dd>{model.modalities.join(' · ')}</dd></div><div><dt>Context</dt><dd>{model.contextTokens.toLocaleString('en-US')} tokens</dd></div><div><dt>Privacy</dt><dd>{model.privacy}</dd></div><div><dt>Input</dt><dd>{money(model.inputUsdPerMillion)}</dd></div><div><dt>Output</dt><dd>{money(model.outputUsdPerMillion)}</dd></div></dl>
    <h2>v0.3 test coverage</h2>
    <div class="coverage-grid coverage-grid--profile">{model.modalities.map((modality) => { const meta = modalityMeta[modality]; const tests = v03CasesByModality.get(modality) || []; return <article data-modality={modality}><span>{meta.code}</span><h3>{meta.label}</h3><strong>{retained ? tests.length : 0} / {tests.length}</strong><p>{retained ? 'executed · review pending' : 'no retained run'}</p><a href={`/rankings/${modality}/`}>Track evidence →</a></article>; })}</div>
    <div class="review-banner"><span class="state-dot state-dot--pending"></span><div><strong>{retained ? 'Publication gate closed' : 'Route excluded'}</strong><p>{retained ? `Run ${v03Run.runId} remains live-unreviewed. This page intentionally contains no raw output, rank, or classifier claim.` : 'No result is inferred from transport failure.'}</p></div></div>
    <h2>Sources</h2><ul class="source-list">{model.sourceUrls.map((url) => <li><a href={url} rel="noreferrer">{url}</a></li>)}</ul>
    <p class="archive-note">Historical v0.2 evidence, where available, now lives in the <a href="/archive/v02/">retired benchmark archive</a>.</p>
  </article>
</BaseLayout>
