---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ModelGrid from '../../components/ModelGrid.astro';
import { mediaModels, models } from '../../data/models';
import { publicResultsV02 } from '../../lib/results-v02';
const hasLive = publicResultsV02.results.some((result) => result.evidenceState === 'live-reviewed' && result.humanReviewed);
---
<BaseLayout title="Uncensored AI model directory" description="Browse the launch roster by provider, privacy route, and use case. Untested models remain unranked." noindex={!hasLive}>
  <header class="page-head"><div class="shell"><p class="kicker">Model directory</p><h1>Models under test</h1><p class="lede">Seventeen models across text, image, video, and audio are in the launch protocol. Filter the roster, inspect provider facts, and open any profile for its full per-case evidence.</p></div></header>
  <section class="section shell">
    <ModelGrid models={[...models, ...mediaModels]} enableFilters={true} />
  </section>
</BaseLayout>
