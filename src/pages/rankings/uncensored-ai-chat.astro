---
import RankingPage from '../../components/RankingPage.astro';
import { models } from '../../data/models';
const roster = models.filter((model) => model.tags.some((tag) => ['roleplay', 'uncensored', 'creative-writing', 'dialogue'].includes(tag)));
---
<RankingPage
  title="Best uncensored AI chat models"
  description="Evidence-gated comparison of uncensored AI chat models: delivery rate, roleplay consistency, memory, privacy, and cost per conversation."
  kicker="Uncensored chat ranking"
  models={roster}
  intro="Uncensored chat means the model delivers on lawful requests without refusal. This ranking scores models on instruction following, output quality, speed, and cost — never publishing a rank without live test evidence."
/>
