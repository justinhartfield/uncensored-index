---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { mediaModels, models } from '../../data/models';
import { modalityMeta, v03Modalities, v03Run, v03RunModelSlugs } from '../../data/v03-suite';
const roster = [...models, ...mediaModels];
---
<BaseLayout title="v0.3 live run ledger" description="Coverage, spend, provider failures, and review state for the completed Uncensored Index v0.3 live benchmark run." noindex={true}>
  <header class="page-head page-head--dark"><div class="shell page-head__grid"><div><p class="kicker">Live run / evidence state</p><h1>Complete run.<br />Zero published ranks.</h1><p class="lede">The provider work finished on 3 August 2026. This page reports execution coverage and technical state—not model quality—while all artifacts await two-reviewer approval.</p></div><dl class="page-stats"><div><dt>Executions</dt><dd>{v03Run.caseExecutions}</dd></div><div><dt>Artifacts</dt><dd>{v03Run.artifacts}</dd></div><div><dt>Review complete</dt><dd>0%</dd></div><div><dt>Spend</dt><dd>${v03Run.estimatedSpendUsd.toFixed(2)}</dd></div></dl></div></header>
  <section class="section shell">
    <div class="run-identity"><div><span>RUN ID</span><code>{v03Run.runId}</code></div><div><span>CATALOG</span><strong>0.3.0 / 33 cases</strong></div><div><span>STATE</span><strong>live-unreviewed</strong></div><div><span>CAP</span><strong>${v03Run.maxSpendUsd.toFixed(2)}</strong></div></div>
    <div class="coverage-grid">{v03Modalities.map((modality) => { const meta = modalityMeta[modality]; const executions = modality === 'text' ? 117 : modality === 'image' ? 33 : modality === 'video' ? 8 : 5; return <article data-modality={modality}><span>{meta.code}</span><h2>{meta.label}</h2><strong>{executions}</strong><p>case executions across {meta.routeCount} route{meta.routeCount === 1 ? '' : 's'}</p><a href={`/rankings/${modality}/`}>Track ledger →</a></article>; })}</div>
  </section>
  <section class="section section--tint"><div class="shell"><div class="section-head"><div><p class="kicker">Route ledger</p><h2>18 retained model records</h2></div><p>Scores intentionally absent.</p></div><div class="ledger-list">{roster.map((model) => <a class="ledger-row" href={`/models/${model.slug}/`}><span>{model.displayName}</span><span>{model.modalities.join(' / ')}</span><span>{v03RunModelSlugs.has(model.slug) ? 'live / pending review' : 'excluded / transport timeout'}</span></a>)}</div></div></section>
  <section class="section shell"><div class="section-head"><div><p class="kicker">Failure ledger</p><h2>Two failures stayed failures.</h2></div></div><div class="failure-list">{v03Run.technicalFailureCases.map((failure) => <article><code>{failure.testId}</code><div><strong>{roster.find((model) => model.slug === failure.modelSlug)?.displayName || failure.modelSlug}</strong><p>{failure.label}. Isolated retry reproduced the failure; publication gate rejects the evidence.</p></div><span class="status-tag status-tag--error">Technical</span></article>)}</div></section>
  <section class="section section--dark"><div class="shell review-cta"><div><p class="kicker">Next gate</p><h2>Humans decide what the prefill means.</h2></div><div><p>Automated prefill currently labels 128 full, 24 softened, 9 refused, and 2 failed outcomes. Those numbers are not findings until reviewers inspect the artifacts and attribution.</p><a class="button" href="/review/">Open the review ledger</a></div></div></section>
</BaseLayout>
