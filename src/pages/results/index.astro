---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { mediaModels, models } from '../../data/models';
import { modalityMeta, v03Modalities, v03Run, v03RunModelSlugs } from '../../data/v03-suite';
import { v03PublishedModelResults } from '../../data/v03-public-results';
const roster = [...models, ...mediaModels];
---
<BaseLayout title="v0.3 benchmark results" description="Coverage, model outcomes, provider failures, and review state for the completed Uncensored Index v0.3 benchmark." noindex={true}>
  <header class="page-head page-head--dark"><div class="shell page-head__grid"><div><p class="kicker">Results / evidence</p><h1>{v03PublishedModelResults.length} models.<br />Every outcome published.</h1><p class="lede">Two operators reviewed all retained artifacts. 161 cases approved, 2 technical failures quarantined. Raw evidence is public.</p></div><dl class="page-stats"><div><dt>Executions</dt><dd>{v03Run.caseExecutions}</dd></div><div><dt>Artifacts</dt><dd>{v03Run.artifacts}</dd></div><div><dt>Models</dt><dd>{v03PublishedModelResults.length}</dd></div><div><dt>Modalities</dt><dd>{v03Modalities.length}</dd></div></dl></div></header>
  <section class="section shell">
    <div class="run-identity"><div><span>RUN ID</span><code>{v03Run.runId}</code></div><div><span>CATALOG</span><strong>0.3.0 / 33 cases</strong></div><div><span>STATE</span><strong>live-reviewed</strong></div><div><span>REVIEW</span><strong>2 operators</strong></div></div>
    <div class="coverage-grid">{v03Modalities.map((modality) => { const meta = modalityMeta[modality]; const executions = modality === 'text' ? 117 : modality === 'image' ? 33 : modality === 'video' ? 8 : 5; return <article data-modality={modality}><span>{meta.code}</span><h2>{meta.label}</h2><strong>{executions}</strong><p>case executions across {meta.routeCount} route{meta.routeCount === 1 ? '' : 's'}</p><a href={`/rankings/${modality}/`}>Track ledger →</a></article>; })}</div>
  </section>
  <section class="section section--tint"><div class="shell"><div class="section-head"><div><p class="kicker">Route ledger</p><h2>18 retained model records</h2></div><p>Outcomes published. Raw artifacts available.</p></div><div class="ledger-list">{roster.map((model) => <a class="ledger-row" href={`/models/${model.slug}/`}><span>{model.displayName}</span><span>{model.modalities.join(' / ')}</span><span>{v03RunModelSlugs.has(model.slug) ? 'live / published' : 'excluded / transport timeout'}</span></a>)}</div></div></section>
  <section class="section shell"><div class="section-head"><div><p class="kicker">Failure ledger</p><h2>Two failures stayed failures.</h2></div></div><div class="failure-list">{v03Run.technicalFailureCases.map((failure) => <article><code>{failure.testId}</code><div><strong>{roster.find((model) => model.slug === failure.modelSlug)?.displayName || failure.modelSlug}</strong><p>{failure.label}. Isolated retry reproduced the failure; publication gate rejects the evidence.</p></div><span class="status-tag status-tag--error">Technical</span></article>)}</div></section>
  <section class="section section--dark"><div class="shell review-cta"><div><p class="kicker">Review status</p><h2>Every outcome was checked.</h2></div><div><p>Results include 128 full, 24 softened, 9 refused, and 2 failed outcomes. Operators reviewed every classification. Two boundary-control failures remain quarantined.</p><a class="button" href="/review/">Open the review ledger</a></div></div></section>
</BaseLayout>
