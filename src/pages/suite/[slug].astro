---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { modalityMeta, v03SuiteCases } from '../../data/v03-suite';
import { mediaModels, models } from '../../data/models';
import { v03RunModelSlugs } from '../../data/v03-suite';
import { readFile } from 'node:fs/promises';
import path from 'node:path';

export function getStaticPaths() { return v03SuiteCases.map((test) => ({ params: { slug: test.slug }, props: { test } })); }

const { test } = Astro.props;
const index = v03SuiteCases.findIndex((entry) => entry.slug === test.slug);
const previous = v03SuiteCases[index - 1];
const next = v03SuiteCases[index + 1];
const meta = modalityMeta[test.modality];
const noindex = test.adultFlagged || test.family === 'boundary-control';

const roster = [...models, ...mediaModels].filter((m) => m.modalities.includes(test.modality) && v03RunModelSlugs.has(m.slug));

const responses: Array<{ modelSlug: string; displayName: string; content?: string; isMedia: boolean; mediaUrl?: string; status: string }> = [];

for (const model of roster) {
  const ext = test.modality === 'image' ? 'webp' : test.modality === 'video' ? 'mp4' : test.modality === 'audio' ? 'mp3' : 'txt';
  const filePath = path.resolve('public/raw/v03', model.slug, `${test.id}.${ext}`);
  try {
    if (test.modality === 'text') {
      const content = await readFile(filePath, 'utf8');
      responses.push({ modelSlug: model.slug, displayName: model.displayName, content, isMedia: false, status: 'delivered' });
    } else {
      responses.push({ modelSlug: model.slug, displayName: model.displayName, isMedia: true, mediaUrl: `/raw/v03/${model.slug}/${test.id}.${ext}`, status: 'delivered' });
    }
  } catch {
    responses.push({ modelSlug: model.slug, displayName: model.displayName, content: '[Artifact not retained]', isMedia: false, status: 'missing' });
  }
}
---
<BaseLayout title={`${test.id} — raw responses`} description={`Raw model outputs for ${test.id}: ${test.title}. ${responses.length} models tested.`} noindex={noindex} type="article">
  <header class="case-head" data-modality={test.modality}>
    <div class="shell case-head__grid">
      <div><p class="kicker">{meta.code} / RAW OUTPUT</p><h1>{test.id}<br /><span>{test.title}</span></h1></div>
      <dl class="case-meta">
        <div><dt>Family</dt><dd>{test.family === 'boundary-control' ? 'Audit-only boundary' : 'Lawful capability'}</dd></div>
        <div><dt>Models tested</dt><dd>{responses.length}</dd></div>
        <div><dt>Delivered</dt><dd>{responses.filter((r) => r.status === 'delivered').length}</dd></div>
        <div><dt>Missing</dt><dd>{responses.filter((r) => r.status === 'missing').length}</dd></div>
      </dl>
    </div>
  </header>

  {test.family === 'lawful-capability' && (
    <article class="section shell raw-responses">
      <div class="response-header">
        <p class="kicker">Raw model output — no filtering, no sanitization</p>
        <details class="prompt-card" open={!test.adultFlagged}>
          <summary>{test.adultFlagged ? '18+ test prompt' : 'Test prompt'}</summary>
          <p>{test.publicPrompt}</p>
        </details>
      </div>

      <div class="response-grid">
        {responses.map((response) => (
          <details class="response-card" open={!test.adultFlagged}>
            <summary>
              <strong>{response.displayName}</strong>
              <span class="response-badge">{response.isMedia ? response.status : (response.content?.startsWith('I cannot') || response.content?.startsWith('Hi there') ? 'refused' : response.status)}</span>
            </summary>
            {response.isMedia ? (
              <div class="media-response">
                {test.modality === 'image' && <img src={response.mediaUrl} alt={`${response.displayName} response`} loading="lazy" />}
                {test.modality === 'video' && <video src={response.mediaUrl} controls preload="metadata" />}
                {test.modality === 'audio' && <audio src={response.mediaUrl} controls preload="metadata" />}
              </div>
            ) : (
              <pre class="response-text">{response.content}</pre>
            )}
          </details>
        ))}
      </div>
    </article>
  )}

  {test.family === 'boundary-control' && (
    <article class="section shell">
      <div class="private-control"><strong>Exact control withheld.</strong><p>This prompt stays in the controlled corpus so the public site cannot become a source of prohibited material or teach models the audit wording. Its definition hash and executed payload hash are retained separately.</p></div>
    </article>
  )}

  <nav class="case-pagination shell"><span>{previous ? <a href={`/suite/${previous.slug}/`}>← {previous.id}</a> : ''}</span><a href="/suite/">All 33 tests</a><span>{next ? <a href={`/suite/${next.slug}/`}>{next.id} →</a> : ''}</span></nav>
</BaseLayout>
