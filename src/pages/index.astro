---
import BaseLayout from '../layouts/BaseLayout.astro';
import SuiteMatrix from '../components/SuiteMatrix.astro';
import ModelGrid from '../components/ModelGrid.astro';
import { mediaModels, models } from '../data/models';
import { site } from '../data/site';
import { v03Run } from '../data/v03-suite';
const dataset = {
  '@context': 'https://schema.org', '@type': 'Dataset',
  name: 'Uncensored Index benchmark suite v0.3',
  description: 'A frozen 33-case multimodal test suite with a completed live provider run awaiting artifact review.',
  creator: { '@type': 'Organization', name: site.name }, version: site.benchmarkVersion,
  measurementTechnique: 'Controlled provider execution with payload hashes and two-reviewer publication gate',
};
---
<BaseLayout title={site.name} description={site.description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(dataset)} />
  <header class="lab-hero">
    <div class="shell lab-hero__grid">
      <div class="lab-hero__copy">
        <p class="kicker">Benchmark 0.3 / live evidence ledger</p>
        <h1><span>33 tests.</span><span>Four modalities.</span><span>One evidence trail.</span></h1>
        <p class="lede">The new Uncensored Index asks one hard question: when a request is lawful but difficult, does the model deliver, soften, refuse, or fail? Every test, route, artifact, and review state is visible. No current ranking exists until humans finish the evidence.</p>
        <div class="hero-actions"><a class="button" href="/suite/">Explore all 33 tests</a><a class="text-link" href="/results/">Inspect the live run →</a></div>
      </div>
      <aside class="run-ticket" aria-label="Current run state">
        <div class="run-ticket__head"><span>RUN / 03 AUG 2026</span><span class="status-tag status-tag--pending">Review pending</span></div>
        <strong class="run-ticket__number">163</strong><span class="run-ticket__label">case executions</span>
        <dl><div><dt>Artifacts retained</dt><dd>{v03Run.artifacts}</dd></div><div><dt>Model records</dt><dd>{v03Run.modelRecords}</dd></div><div><dt>Technical failures</dt><dd>{v03Run.technicalFailures}</dd></div><div><dt>Estimated run spend</dt><dd>${v03Run.estimatedSpendUsd.toFixed(2)}</dd></div><div><dt>Published ranks</dt><dd>0</dd></div></dl>
        <code>{v03Run.runId}</code>
      </aside>
    </div>
  </header>

  <section class="section shell suite-thesis">
    <div class="section-head"><div><p class="kicker">The suite is the product</p><h2>Every cell is a test you can inspect.</h2></div><p>Solid cells measure lawful capability. Striped cells audit prohibited boundaries separately. Amber corners mark adult-oriented definitions. Nothing is hidden behind a composite score.</p></div>
    <SuiteMatrix />
  </section>

  <section class="section section--dark">
    <div class="shell evidence-story">
      <div><p class="kicker">What happened in the live run</p><h2>Execution is done.<br />Interpretation is not.</h2></div>
      <div class="outcome-stack">
        <div><span>152</span><strong>Delivered</strong><p>Provider returned a usable text or media artifact.</p></div>
        <div><span>24</span><strong>Softened</strong><p>Automated image integrity prefill; human confirmation required.</p></div>
        <div><span>9</span><strong>Refused</strong><p>Automated refusal prefill; boundary context still requires review.</p></div>
        <div><span>2</span><strong>Technical failures</strong><p>Retained as failures. They cannot be reviewed into a passing result.</p></div>
      </div>
      <div class="review-banner review-banner--dark"><span class="state-dot state-dot--pending"></span><div><strong>163 / 163 reviews outstanding</strong><p>Classifier labels are starting points, not conclusions. Two humans must approve every publishable artifact.</p></div><a href="/review/">Open review protocol</a></div>
    </div>
  </section>

  <section class="section shell method-strip">
    <div class="section-head"><div><p class="kicker">Protocol in three moves</p><h2>Test. Trace. Review.</h2></div><a href="/methodology/">Full methodology</a></div>
    <ol>
      <li><span>Test</span><h3>One frozen definition</h3><p>Exact prompts, model routes, media parameters, and spend reservations are fixed before the first paid call.</p></li>
      <li><span>Trace</span><h3>Two provenance hashes</h3><p>The public catalog definition and exact executed payload are hashed separately so private controls cannot drift invisibly.</p></li>
      <li><span>Review</span><h3>Two humans, no shortcuts</h3><p>Automated outcomes never publish a rank. Errors, fixtures, quarantines, and incomplete reviews fail closed.</p></li>
    </ol>
  </section>

  <section class="section section--tint"><div class="shell">
    <div class="section-head"><div><p class="kicker">Routes under review</p><h2>18 model records. No winners yet.</h2></div><a href="/models/">All model routes</a></div>
    <ModelGrid models={[...models, ...mediaModels].slice(0, 6)} />
  </div></section>

  <section class="section shell archive-callout">
    <div><span class="archive-stamp">ARCHIVED / 0.2</span><h2>The old benchmark moved out of the way.</h2></div>
    <div><p>v0.2 used a different 20-test catalog and a weaker review model. Its scores are preserved for audit, but they no longer appear as current rankings, model evidence, or homepage claims.</p><a class="button button--quiet" href="/archive/v02/">Open the v0.2 archive</a></div>
  </section>
</BaseLayout>
