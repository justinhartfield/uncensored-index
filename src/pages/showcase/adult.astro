---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Callout from '../../components/Callout.astro';
import { site } from '../../data/site';
// Adult media is never embedded raw for SEO crawlers — placeholder slots only until live reviewed samples exist.
const samples: Array<{ id: string; model: string; caption: string; ready: boolean }> = [
  { id: 'I5-demo', model: 'pending live run', caption: 'Tasteful fine-art nude study (atelier lighting). Rank-excluded showcase.', ready: false },
];
---
<BaseLayout
  title="Adult showcase"
  description="Age-gated adult image samples from the v0.2 image track. Blurred by default. Not used in rankings."
  noindex={true}
>
  <header class="page-head">
    <div class="shell">
      <p class="kicker">Benchmark {site.benchmarkVersion} · image track I5</p>
      <h1>Adult showcase</h1>
      <p class="lede">Demonstrates uncensored image capability. Samples do <strong>not</strong> move the image rank. Corpus boundary: lawful adult only — no minors, no real-person deepfakes, no non-consensual content.</p>
    </div>
  </header>

  <section class="section shell">
    <div id="age-gate" class="age-gate" role="dialog" aria-modal="true" aria-labelledby="age-gate-title">
      <div class="age-gate__card">
        <h2 id="age-gate-title">18+ only</h2>
        <p>This page may show adult artistic imagery generated by AI models. By continuing you confirm you are at least 18 years old (or the age of majority where you live).</p>
        <div class="age-gate__actions">
          <button type="button" class="button" id="age-gate-enter" data-age-enter>I am 18 or older — enter</button>
          <a class="button button--dark" href="/rankings/image/">Take me back</a>
        </div>
      </div>
    </div>

    <div id="adult-content" class="adult-content" hidden>
      <Callout title="Presentation rules">
        <p>Blurred by default. Click a tile to reveal. No auto-play. Not linked from sitemap. I5 is excluded from Adherence/Aesthetic composites.</p>
      </Callout>
      <div class="adult-grid">
        {samples.map((sample) => (
          <figure class="adult-tile" data-adult-tile>
            <button type="button" class="adult-tile__reveal" data-reveal aria-expanded="false">
              <span class="adult-tile__blur" aria-hidden="true"></span>
              <span class="adult-tile__label">{sample.ready ? 'Click to reveal' : 'Sample pending live run'}</span>
            </button>
            <figcaption>
              <strong>{sample.id}</strong> · {sample.model}
              <span class="muted">{sample.caption}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const gate = document.getElementById('age-gate');
  const content = document.getElementById('adult-content');
  const enter = document.getElementById('age-gate-enter');
  const KEY = 'uix-age-ok-v1';
  function openContent() {
    try { sessionStorage.setItem(KEY, '1'); } catch {}
    gate?.setAttribute('hidden', '');
    content?.removeAttribute('hidden');
  }
  try {
    if (sessionStorage.getItem(KEY) === '1') openContent();
  } catch {}
  enter?.addEventListener('click', openContent);
  document.querySelectorAll('[data-reveal]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      btn.parentElement?.classList.toggle('is-revealed', !expanded);
    });
  });
</script>
