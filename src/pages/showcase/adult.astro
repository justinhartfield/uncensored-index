---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Callout from '../../components/Callout.astro';
import { adultShowcaseSamples } from '../../data/adult-showcase';
import { publicResultsV02 } from '../../lib/results-v02';
import { reviewedMediaSource } from '../../lib/media-evidence';
import { site } from '../../data/site';

const samples = adultShowcaseSamples.map((sample) => {
  const imageRun = publicResultsV02.results.find((result) => result.modelSlug === sample.modelSlug);
  const evidence = imageRun?.cases?.find((result) => result.testId === sample.id);
  const promotedSrc = reviewedMediaSource(evidence?.mediaMeta, true);
  const assetSrc = promotedSrc || (sample.reviewed ? sample.assetSrc : undefined);
  return { ...sample, assetSrc, evidence, ready: Boolean(assetSrc) };
});
---
<BaseLayout
  title="Adult showcase"
  description="Age-gated adult image samples from the v0.2 image track. Blurred by default. Not used in rankings."
  noindex={true}
>
  <header class="page-head">
    <div class="shell">
      <p class="kicker">Benchmark {site.benchmarkVersion} · image track I5</p>
      <h1>Adult showcase</h1>
      <p class="lede">Demonstrates uncensored image capability. Samples do <strong>not</strong> move the image rank. Corpus boundary: lawful adult only — no minors, no real-person deepfakes, no non-consensual content.</p>
    </div>
  </header>

  <section class="section shell">
    <div id="age-gate" class="age-gate" role="dialog" aria-modal="true" aria-labelledby="age-gate-title">
      <div class="age-gate__card">
        <h2 id="age-gate-title">18+ only</h2>
        <p>This page may show adult artistic imagery generated by AI models. By continuing you confirm you are at least 18 years old (or the age of majority where you live).</p>
        <div class="age-gate__actions">
          <button type="button" class="button" id="age-gate-enter" data-age-enter>I am 18 or older — enter</button>
          <a class="button button--dark" href="/rankings/image/">Take me back</a>
        </div>
      </div>
    </div>

    <div id="adult-content" class="adult-content" tabindex="-1" hidden>
      <Callout title="Presentation rules">
        <p>Only reviewed retained artifacts appear here. These three sources are uniformly blurred and therefore non-interactive. Not linked from sitemap. I5 is excluded from Adherence/Aesthetic composites.</p>
      </Callout>
      <Callout title="Current comparison coverage" warning={true}>
        <p>Three image models completed the same lawful-adult I5 prompt. Every retained provider output is itself uniformly blurred, so none contains hidden source pixels this site can reveal.</p>
      </Callout>
      {samples.every((sample) => !sample.ready) && (
        <Callout title="Generated evidence retained; public asset awaiting review" warning={true}>
          <p>No reviewed I5 image is available in the public corpus. The gallery will not fabricate or expose an unreviewed replacement. A retained asset must pass human corpus-boundary review before reveal is enabled.</p>
        </Callout>
      )}
      <div class="adult-grid">
        {samples.map((sample) => (
          <figure class={`adult-tile ${sample.internalBlur ? 'is-blur-placeholder' : ''}`} data-adult-tile>
            {sample.ready ? (
              sample.internalBlur ? (
                <div class="adult-tile__reveal adult-tile__unblur-disabled">
                  <img class="adult-tile__image adult-tile__flat" src={sample.assetSrc} alt={sample.alt || ''} loading="lazy" />
                  <span class="adult-tile__label">Provider returned a uniformly blurred image</span>
                  <span class="adult-tile__disclaimer">This is the complete retained output. The site cannot reveal detail that is absent from the source file, and the evidence does not establish why the provider returned it this way.</span>
                </div>
              ) : (
                <button type="button" class="adult-tile__reveal" data-reveal aria-expanded="false">
                  <img class="adult-tile__image" src={sample.assetSrc} alt={sample.alt || ''} loading="lazy" />
                  <span class="adult-tile__label">Click to reveal</span>
                </button>
              )
            ) : (
              <div class="adult-tile__reveal adult-tile__unavailable">
                <span class="adult-tile__blur" aria-hidden="true"></span>
                <span class="adult-tile__label">Asset awaiting review</span>
              </div>
            )}
            <figcaption>
              <strong>{sample.id}</strong> · <a href={`/models/${sample.modelSlug}/`}>{sample.modelName}</a>
              <span class="muted">{sample.caption}</span>
              <span class="micro">
                Live result: {sample.evidence?.status || sample.status || 'unavailable'}
                {(sample.evidence?.latencyMs || sample.latencyMs) ? ` · ${((sample.evidence?.latencyMs || sample.latencyMs || 0) / 1000).toFixed(1)}s` : ''}
                {(sample.evidence?.estimatedCostUsd ?? sample.estimatedCostUsd) !== undefined ? ` · $${(sample.evidence?.estimatedCostUsd ?? sample.estimatedCostUsd ?? 0).toFixed(4)}` : ''}
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const KEY = 'uix-age-ok-v1';
  const gate = document.getElementById('age-gate');
  const content = document.getElementById('adult-content');

  function openContent({ moveFocus = false } = {}) {
    try { localStorage.setItem(KEY, '1'); } catch {}
    gate?.setAttribute('hidden', '');
    content?.removeAttribute('hidden');
    document.body.classList.add('uix-18-plus');
    if (moveFocus) content?.focus();
  }

  try {
    if (localStorage.getItem(KEY) === '1') openContent();
  } catch {}

  document.getElementById('age-gate-enter')?.addEventListener('click', (e) => {
    e.preventDefault();
    openContent({ moveFocus: true });
  });

  // Smooth reveal remains available for future reviewed tiles that contain revealable source pixels.
  document.querySelectorAll('[data-reveal]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      btn.parentElement?.classList.toggle('is-revealed', !expanded);
    });
  });
</script>
<style>
  .adult-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; margin-top: 1.5rem; }
  .adult-tile { position: relative; border-radius: var(--radius); overflow: hidden; background: var(--bg-elevated); }
  .adult-tile__reveal { width: 100%; aspect-ratio: 3/4; position: relative; cursor: pointer; background: var(--ink-muted); border: none; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--ink); font-weight: 600; padding: 1rem; }
  .adult-tile__image { width: 100%; height: auto; display: block; }
  .adult-tile__flat { opacity: 1 !important; }
  .adult-tile.is-revealed .adult-tile__blur { opacity: 0; pointer-events: none; }
  
  /* Blur placeholder styling */
  .adult-tile.is-blur-placeholder .adult-tile__reveal { background: var(--bg-base); }
  .adult-tile.is-blur-placeholder .adult-tile__label { font-size: 0.85rem; margin-top: 0.5rem; color: var(--ink-secondary); font-style: italic; }
  .adult-tile.is-blur-placeholder .adult-tile__disclaimer { display: block; text-align: left; width: 100%; font-size: 0.78rem; color: var(--ink-secondary); line-height: 1.45; margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--line); }
  .adult-tile__unblur-disabled { cursor: default; }
  
  .adult-tile figcaption { padding: 0.75rem 1rem; border-top: 1px solid var(--line); font-size: 0.85rem; line-height: 1.4; }
  .age-gate-enter { font-weight: 600; padding: 0.75rem 1.5rem; }
  .adult-tile__unavailable { width: 100%; aspect-ratio: 3/4; display: flex; align-items: center; justify-content: center; background: var(--bg-elevated); color: var(--ink-secondary); font-size: 0.9rem; }
</style>
